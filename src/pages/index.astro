---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import homeData from '../data/home.json';
import { base, cmsImage } from '../utils/cms';

const directory = (homeData.directory || []).map((item) => ({
  ...item,
  href: item.link.startsWith('http') ? item.link : `${base}${item.link}`,
  imageSrc: cmsImage(item.image),
}));
---

<BaseLayout
  title="Kacper Czeczot — Dyrygent · Multiinstrumentalista · Aranżer"
  description="Oficjalne portfolio artystyczne Kacpra Czeczota: dyrygentura symfoniczna i chóralna, wykonawstwo sceniczne, opracowania partytur oraz realizacja dźwięku."
>
  <Hero />

  <!-- Sekcja: Profil Artystyczny i Filary Działalności -->
  <section id="profil" class="py-20 border-t border-white/10 bg-ocean-950 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Wstęp narracyjny -->
      <div class="max-w-3xl mb-16 space-y-6">
        <p class="text-xs font-semibold tracking-widest text-sky-400 font-sans uppercase">
          Profil Artystyczny & Doświadczenie
        </p>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight leading-tight">
          Warsztat dyrygencki, kreacja sceniczna i autorska orkiestracja
        </h2>
        <div class="space-y-4 text-base sm:text-lg text-slate-300 font-sans font-light leading-relaxed">
          <p>
            Kacper Czeczot to dyrygent, kapelmistrz, aranżer i multiinstrumentalista, łączący dyscyplinę klasycznej tradycji symfonicznej z dynamiczną energią wykonawstwa estradowego. Absolwent dyrygentury w Instytucie Muzyki Uniwersytetu Warmińsko-Mazurskiego w Olsztynie, uhonorowany prestiżowym tytułem Najlepszego Absolwenta Wydziału Sztuki oraz Nagrodą Dziekana za wybitne artystyczne dzieło dyplomowe — Koncert „Finale” z orkiestrą symfoniczną w Filharmonii Warmińsko-Mazurskiej. Jest również wyróżnionym absolwentem Państwowej Szkoły Muzycznej I i II st. im. A. Krzanowskiego w Mławie w klasie fortepianu oraz na wydziale wokalnym z tytułem zawodowego muzyka.
          </p>
          <p>
            Aktywność artystyczna artysty obejmuje salę filharmoniczną, teatr muzyczny, scenę orkiestr dętych oraz studio nagraniowe. Z dorobkiem ponad 300 występów estradowych i tras koncertowych w 6 krajach Europy, Kacper Czeczot tworzy i realizuje wielowymiarowe projekty muzyczne: od monumentalnych dzieł oratoryjno-kantatowych i symfonicznych po autorskie aranżacje partytur oraz nowoczesną realizację dźwięku.
          </p>
        </div>
      </div>

      <!-- 4 Filary Kompetencji -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="border border-white/10 bg-ocean-900/60 p-6 sm:p-8 flex flex-col justify-between editorial-hover">
          <div>
            <span class="text-xs font-mono text-sky-400 uppercase tracking-wider block mb-3">01 · Dyrygentura</span>
            <h3 class="text-xl font-bold text-white mb-3 tracking-tight">Kierownictwo muzyczne</h3>
            <p class="text-sm text-slate-300 font-light leading-relaxed">
              Prowadzenie orkiestr symfonicznych, orkiestr dętych oraz zespołów chóralnych. Dogłębna praca analityczna nad partyturą, budowanie zrównoważonego brzmienia i interpretacja repertuaru klasycznego, sakralnego oraz filmowego.
            </p>
          </div>
        </div>

        <div class="border border-white/10 bg-ocean-900/60 p-6 sm:p-8 flex flex-col justify-between editorial-hover">
          <div>
            <span class="text-xs font-mono text-sky-400 uppercase tracking-wider block mb-3">02 · Aranżacja</span>
            <h3 class="text-xl font-bold text-white mb-3 tracking-tight">Partytury i orkiestracja</h3>
            <p class="text-sm text-slate-300 font-light leading-relaxed">
              Autorskie opracowania i transkrypcje muzyczne na składy symfoniczne, orkiestry dęte i chóry. Przygotowywanie materiałów wykonawczych na zamówienie instytucji kultury, festiwali oraz formacji scenicznych.
            </p>
          </div>
        </div>

        <div class="border border-white/10 bg-ocean-900/60 p-6 sm:p-8 flex flex-col justify-between editorial-hover">
          <div>
            <span class="text-xs font-mono text-sky-400 uppercase tracking-wider block mb-3">03 · Wykonawstwo</span>
            <h3 class="text-xl font-bold text-white mb-3 tracking-tight">Multiinstrumentalizm</h3>
            <p class="text-sm text-slate-300 font-light leading-relaxed">
              Wieloletnie doświadczenie koncertowe jako pianista, klarnecista, organista oraz solista wokalny. Łączenie stylistyki klasycznej, muzyki teatralnej, operetkowej i współczesnej ekspresji estradowej.
            </p>
          </div>
        </div>

        <div class="border border-white/10 bg-ocean-900/60 p-6 sm:p-8 flex flex-col justify-between editorial-hover">
          <div>
            <span class="text-xs font-mono text-sky-400 uppercase tracking-wider block mb-3">04 · Fonografia</span>
            <h3 class="text-xl font-bold text-white mb-3 tracking-tight">Inżynieria dźwięku</h3>
            <p class="text-sm text-slate-300 font-light leading-relaxed">
              Kompleksowa realizacja nagrań sesyjnych i koncertowych, mastering materiałów akustycznych oraz technologiczne przygotowanie produkcji multimedialnych na najwyższym poziomie wierności brzmieniowej.
            </p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <section id="nawigacja" class="py-20 border-t border-white/10 bg-ocean-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mb-8">
        Katalog portfolio & Sekcje
      </h2>

      <nav aria-label="Nawigacja po stronach" class="border-t border-white/10">
        {directory.map((item) => (
          <a
            href={item.href}
            class="group grid grid-cols-1 lg:grid-cols-12 gap-6 items-center py-8 border-b border-white/10 editorial-hover px-2"
          >
            <div class="lg:col-span-7 flex items-center justify-between gap-6">
              <div class="flex items-center gap-6 sm:gap-8">
                <span class="text-xs font-mono text-slate-500 tabular-nums">{item.index}</span>
                <div>
                  <p class="text-xs tracking-widest text-sky-400 uppercase font-semibold">{item.category}</p>
                  <h3 class="text-2xl sm:text-3xl font-bold text-white group-hover:text-sky-300 transition-colors mt-1">
                    {item.title}
                  </h3>
                </div>
              </div>
              <span aria-hidden="true" class="text-xl text-slate-500 transition-all duration-300 group-hover:translate-x-2 group-hover:text-sky-400">
                →
              </span>
            </div>

            <div class="lg:col-span-5 hidden lg:block">
              <div class="overflow-hidden border border-white/10 aspect-[16/8] bg-ocean-900">
                <img
                  src={item.imageSrc}
                  alt={item.imageAlt}
                  class="w-full h-full object-cover opacity-75 group-hover:scale-105 group-hover:opacity-100 transition-all duration-500"
                />
              </div>
            </div>
          </a>
        ))}
      </nav>
    </div>
  </section>
</BaseLayout>
