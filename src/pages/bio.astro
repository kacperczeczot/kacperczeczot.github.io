---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import bioData from '../data/bio.json';
import { base, cmsImage } from '../utils/cms';

const higherEducation = bioData.higherEducation || [];
const musicSchoolEducation = bioData.musicSchoolEducation || [];
const individualAwards = bioData.individualAwards || [];
const mainInstruments = bioData.mainInstruments || [];
const additionalInstruments = bioData.additionalInstruments || [];
const currentRoles = bioData.currentRoles || [];

const profilePageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: 'Życiorys artystyczny — Kacper Czeczot',
  description: 'Biografia artystyczna, edukacja, instrumentarium, nagrody i pełnione funkcje dyrygenckie Kacpra Czeczota.',
  mainEntity: {
    '@type': 'Person',
    name: 'Kacper Czeczot',
    jobTitle: 'Dyrygent i Muzyk',
    url: 'https://kacperczeczot.github.io'
  }
};
---

<BaseLayout
  title="Życiorys artystyczny — Kacper Czeczot"
  description="Biografia artystyczna, edukacja, instrumentarium, nagrody i pełnione funkcje dyrygenckie Kacpra Czeczota."
  jsonLd={profilePageSchema}
>
  <!-- Hero Section -->
  <section class="relative pt-36 pb-16 md:pt-44 md:pb-20 border-b border-white/10 bg-ocean-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        badge="Sylwetka & Życiorys"
        title="Życiorys artystyczny"
        subtitle="Dyrygent, kierownik muzyczny, aranżer i wokalista. Najlepszy Absolwent Wydziału Sztuki Uniwersytetu Warmińsko-Mazurskiego w Olsztynie."
        align="left"
      />
    </div>
  </section>

  <article class="bg-ocean-950">
    <!-- Wprowadzenie & Portret Główny -->
    <section class="py-16 md:py-24 border-b border-white/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
          <div class="lg:col-span-7 space-y-6">
            <p class="text-xs font-sans uppercase tracking-[0.28em] text-sky-400">Sylwetka</p>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-semibold text-white leading-tight">
              Dyrygentura, wykonawstwo i edukacja muzyczna
            </h2>
            <div class="space-y-5 text-slate-300 font-sans font-light leading-relaxed text-base sm:text-lg">
              <p>
                <strong class="text-white font-medium">Kacper Czeczot</strong> to dyrygent, pedagog i instrumentalista, łączący akademicki warsztat dyrygencki z praktyką estradową i sceniczną. Jego dorobek obejmuje ponad 300 występów koncertowych w salach filharmonicznych, teatrach, świątyniach oraz na estradach plenerowych w kraju i za granicą.
              </p>
              <p>
                Wyróżniony tytułem <strong class="text-white font-medium">Najlepszego Absolwenta Wydziału Sztuki UWM w Olsztynie (2024/2025)</strong> oraz Nagrodą Dziekana za dyplomowe dzieło artystyczne, prowadzi działalność kapelmistrzowską w orkiestrach dętych Mazowsza, wykonawstwo chóralne oraz projekty z zakresu produkcji muzycznej i realizacji dźwięku.
              </p>
            </div>
          </div>

          <figure class="lg:col-span-5 space-y-3">
            <div class="border border-white/10 overflow-hidden shadow-2xl">
              <img
                src={cmsImage(bioData.bioStageImage)}
                alt={bioData.bioStageCaption || "120-lecie I LO w Mławie"}
                class="w-full aspect-[3/2] object-cover hover:scale-105 transition-transform duration-700"
              />
            </div>
            <figcaption class="text-[11px] font-sans uppercase tracking-widest text-slate-500">
              {bioData.bioStageCaption || "120-lecie I LO w Mławie"}
            </figcaption>
          </figure>
        </div>

        <!-- Pełnione funkcje w czytelnych kartach -->
        <div class="pt-8 border-t border-white/10 space-y-4">
          <p class="text-xs font-sans uppercase tracking-[0.22em] text-sky-400">Aktualne stanowiska i funkcje</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {currentRoles.map((post) => (
              <div class="border border-white/10 p-5 bg-ocean-900/30 space-y-1.5 hover:border-sky-500/30 transition-colors">
                <span class="font-display text-base text-white block">{post.title}</span>
                <span class="text-xs text-slate-400 font-sans block">{post.detail}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Rozdział I: Korzenie w Mławie i PSM -->
    <section class="py-16 md:py-24 border-b border-white/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          <figure class="lg:col-span-5 order-2 lg:order-1 space-y-4">
            <div class="border border-white/10 overflow-hidden shadow-xl">
              <img
                src={cmsImage(bioData.bioTheatreImage)}
                alt={bioData.bioTheatreCaption || "„Cud mniemany, czyli Krakowiacy i Górale” (2022) — PSM w Mławie"}
                class="w-full aspect-[16/9] object-cover hover:scale-105 transition-transform duration-700"
              />
            </div>
            <figcaption class="text-[11px] font-sans uppercase tracking-widest text-slate-500">
              {bioData.bioTheatreCaption || "„Cud mniemany, czyli Krakowiacy i Górale” (2022) — PSM w Mławie"}
            </figcaption>
          </figure>

          <div class="lg:col-span-7 order-1 lg:order-2 space-y-6">
            <p class="text-xs font-sans uppercase tracking-[0.28em] text-sky-400">Mława & PSM</p>
            <h3 class="text-2xl sm:text-3xl lg:text-4xl font-display font-semibold text-white leading-tight">
              Edukacja muzyczna w Mławie i scena operetkowa
            </h3>
            <div class="space-y-4 text-slate-300 font-sans font-light leading-relaxed text-base sm:text-lg">
              <p>
                Edukację muzyczną rozpoczął w Państwowej Szkole Muzycznej I i II st. im. Andrzeja Krzanowskiego w Mławie. W 2016 roku ukończył z wyróżnieniem szkołę I stopnia w klasie fortepianu pod kierunkiem Ireneusza Weredy (wcześniej kształcąc się także w klasie skrzypiec). W 2022 roku z wyróżnieniem ukończył Wydział Wokalny II stopnia w klasie śpiewu Michała Gogolewskiego, uzyskując tytuł zawodowy muzyka.
              </p>
              <p>
                W latach nauki w Mławie pełnił funkcję Przewodniczącego Samorządu Uczniowskiego, założył Orkiestrę Samorządu PSM oraz kreował partie wokalno-aktorskie w spektaklach Grupy Operetkowej (m.in. Bryndas i Bartłomiej w widowisku <em>„Cud mniemany, czyli Krakowiacy i Górale”</em> oraz produkcjach <em>„Bal w Savoyu”</em> czy <em>„Gondolierzy”</em>), koncertując w regionie.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Rozdział II: Studia na UWM i dyrygentura -->
    <section class="py-16 md:py-24 border-b border-white/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          <div class="lg:col-span-7 space-y-6">
            <p class="text-xs font-sans uppercase tracking-[0.28em] text-sky-400">UWM w Olsztynie</p>
            <h3 class="text-2xl sm:text-3xl lg:text-4xl font-display font-semibold text-white leading-tight">
              Studia na UWM i Koncert Dyplomowy w Filharmonii
            </h3>
            <div class="space-y-4 text-slate-300 font-sans font-light leading-relaxed text-base sm:text-lg">
              <p>
                Rozwój akademicki kontynuował na Wydziale Sztuki Uniwersytetu Warmińsko-Mazurskiego w Olsztynie. W 2025 roku z wyróżnieniem obronił tytuł licencjata na kierunku <em>Edukacja artystyczna w zakresie sztuki muzycznej</em>, prowadząc Koncert Dyplomowy <strong>„Finale” w sali koncertowej Filharmonii Warmińsko-Mazurskiej</strong>.
              </p>
              <p>
                Za osiągnięcia artystyczne i naukowe otrzymał tytuł <strong>Najlepszego Absolwenta Wydziału Sztuki UWM</strong> oraz Nagrodę Dziekana. Równolegle kształci się na studiach magisterskich oraz na kierunku <em>Produkcja Muzyczna i Realizacja Dźwięku</em>, realizując autorski projekt dyplomowy <em>„Echo Epok”</em>.
              </p>
            </div>
          </div>

          <figure class="lg:col-span-5 space-y-3">
            <div class="border border-white/10 overflow-hidden shadow-2xl">
              <img
                src={cmsImage(bioData.bioScoreImage)}
                alt={bioData.bioScoreCaption || "Koncert Dyplomowy „Finale”"}
                class="w-full aspect-[3/2] object-cover hover:scale-105 transition-transform duration-700"
              />
            </div>
            <figcaption class="text-[11px] font-sans uppercase tracking-widest text-slate-500">
              {bioData.bioScoreCaption || "Koncert Dyplomowy „Finale” — Filharmonia Warmińsko-Mazurska"}
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- Rozdział III: Orkiestry dęte -->
    <section class="py-16 md:py-24 border-b border-white/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          <figure class="lg:col-span-5 order-2 lg:order-1 space-y-4">
            <div class="border border-white/10 overflow-hidden shadow-xl">
              <img
                src={cmsImage(bioData.bioBandImage)}
                alt={bioData.bioBandCaption || "Koncert w Szydłowie"}
                class="w-full aspect-[3/2] object-cover hover:scale-105 transition-transform duration-700"
              />
            </div>
            <figcaption class="text-[11px] font-sans uppercase tracking-widest text-slate-500">
              {bioData.bioBandCaption || "Koncert orkiestry dętej w Szydłowie (2026)"}
            </figcaption>
          </figure>

          <div class="lg:col-span-7 order-1 lg:order-2 space-y-6">
            <p class="text-xs font-sans uppercase tracking-[0.28em] text-sky-400">Orkiestry Dęte</p>
            <h3 class="text-2xl sm:text-3xl lg:text-4xl font-display font-semibold text-white leading-tight">
              Praca z orkiestrami dętymi i aranżacja
            </h3>
            <div class="space-y-4 text-slate-300 font-sans font-light leading-relaxed text-base sm:text-lg">
              <p>
                Ważnym filarem działalności Kacpra Czeczota jest prowadzenie orkiestr dętych. Od grudnia 2025 roku pełni funkcję <strong>Kapelmistrza Orkiestry Dętej GOK w Opinogórze Górnej</strong>, a od 2024 roku funkcję <strong>Zastępcy Kapelmistrza i Instruktora</strong> w Orkiestrze Dętej OSP w Rębowie, OSP Chociszewo oraz OSP Bogate.
              </p>
              <p>
                W pracy z zespołami odpowiada za próby sekcyjne, warsztaty dla młodych muzyków oraz tworzenie własnych opracowań i partytur na skład dęty. Współpracuje także jako instrumentalista i dyrygent m.in. z Młodzieżową Orkiestrą Dętą w Wieczfni Kościelnej, MMOD w Chorzelach oraz OSP Przasnysz.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Rozdział IV: Chóry & Scena -->
    <section class="py-16 md:py-24 border-b border-white/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          <div class="lg:col-span-7 space-y-6">
            <p class="text-xs font-sans uppercase tracking-[0.28em] text-sky-400">Chóry & Scena</p>
            <h3 class="text-2xl sm:text-3xl lg:text-4xl font-display font-semibold text-white leading-tight">
              Działalność chóralna i festiwale
            </h3>
            <div class="space-y-4 text-slate-300 font-sans font-light leading-relaxed text-base sm:text-lg">
              <p>
                Jako wokalista i chórzysta współpracuje z zespołami chóralnymi regionu. W <strong>Chórze im. prof. Wiktora Wawrzyczka UWM</strong> (ponad 70 występów pod batutą prof. Katarzyny Bojaruniec) pełnił funkcję śpiewaka, asystenta dyrygenta w projektach dyplomowych oraz opiekuna biblioteki nutowej, biorąc udział m.in. w festiwalach w Hiszpanii (<em>Cançó Mediterrània</em> w Lloret de Mar i Barcelonie 2025 — Złoty i Srebrny Dyplom), na Litwie (<em>Kaunas Cantat</em> 2025) oraz we Włoszech.
              </p>
              <p>
                Występował także z Chórem <em>„Cantores Varmienses”</em> przy Filharmonii Warmińsko-Mazurskiej, Chórem Kameralnym <em>„Ars Vocale”</em> (Złoty Dyplom w Olsztynie 2023, udział w <em>„Pomerania Cantat”</em> w Słupsku 2024), formacją <em>ProForma Project</em> prof. Marcina Wawruka oraz w musicalu <em>„Pora Jeziora”</em> (Filharmonia w Olsztynie i Opera Krakowska).
              </p>
            </div>
          </div>

          <figure class="lg:col-span-5 space-y-3">
            <div class="border border-white/10 overflow-hidden shadow-2xl">
              <img
                src={cmsImage(bioData.bioChoirImage)}
                alt={bioData.bioChoirCaption || "VII Bałtycki Konkurs Chórów „Pomerania Cantat”, Słupsk (2024)"}
                class="w-full aspect-[3/2] object-cover hover:scale-105 transition-transform duration-700"
              />
            </div>
            <figcaption class="text-[11px] font-sans uppercase tracking-widest text-slate-500">
              {bioData.bioChoirCaption || "VII Bałtycki Konkurs Chórów „Pomerania Cantat”, Słupsk (2024)"}
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- Instrumentarium & Warsztat Muzyczny -->
    <section class="py-16 md:py-24 border-b border-white/10 bg-ocean-950">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
        <div class="space-y-2">
          <p class="text-xs font-sans uppercase tracking-[0.28em] text-sky-400">Warsztat</p>
          <h3 class="text-2xl sm:text-3xl lg:text-4xl font-display font-semibold text-white">
            Instrumentarium & dyscypliny muzyczne
          </h3>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
          <figure class="lg:col-span-5 order-2 lg:order-1 space-y-3">
            <div class="border border-white/10 overflow-hidden shadow-2xl">
              <img
                src={cmsImage(bioData.bioPianoImage)}
                alt={bioData.bioPianoCaption || "Park Miejski w Mławie — fortepian"}
                class="w-full aspect-[3/2] object-cover hover:scale-105 transition-transform duration-700"
              />
            </div>
            <figcaption class="text-[11px] font-sans uppercase tracking-widest text-slate-500">
              {bioData.bioPianoCaption || "Park Miejski w Mławie — fortepian"}
            </figcaption>
          </figure>

          <div class="lg:col-span-7 order-1 lg:order-2 space-y-6">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {mainInstruments.map((inst) => (
                <div class="border border-white/10 p-6 space-y-2 bg-ocean-900/30">
                  <p class="text-[11px] font-sans uppercase tracking-widest text-sky-400">{inst.category}</p>
                  <h4 class="text-xl font-display text-white">{inst.name}</h4>
                  <p class="text-xs text-slate-300 font-sans font-light leading-relaxed">{inst.desc}</p>
                </div>
              ))}
            </div>

            <div class="border border-white/10 p-6 space-y-4 bg-ocean-900/20">
              <h4 class="text-xs font-sans uppercase tracking-[0.22em] text-white">Instrumentarium dodatkowe</h4>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                {additionalInstruments.map((item) => (
                  <div class="space-y-1 border-l border-white/10 pl-3">
                    <h5 class="text-sm font-display text-white">{item.name}</h5>
                    <p class="text-xs text-slate-400 font-sans font-light">{item.desc}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Zestawienie: Edukacja & Nagrody -->
    <section class="py-16 md:py-24 border-b border-white/10 bg-ocean-900/30">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
        <div class="text-center max-w-2xl mx-auto space-y-3">
          <p class="text-xs font-sans uppercase tracking-[0.28em] text-sky-400">Kalendarium</p>
          <h3 class="text-2xl sm:text-3xl font-display font-semibold text-white">
            Edukacja akademicka i muzyczna
          </h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- UWM -->
          <div class="border border-white/10 p-8 space-y-6 bg-ocean-950/60 backdrop-blur-sm">
            <div class="space-y-1">
              <p class="text-xs font-sans uppercase tracking-widest text-sky-400">Szkolnictwo Wyższe</p>
              <h4 class="text-xl font-display text-white">Uniwersytet Warmińsko-Mazurski w Olsztynie</h4>
              <p class="text-xs text-slate-400 font-sans">Wydział Sztuki · Instytut Muzyki</p>
            </div>
            <ul class="space-y-4 text-sm text-slate-300 font-sans font-light divide-y divide-white/5">
              {higherEducation.map((item) => (
                <li class="pt-3 space-y-1">
                  <span class="text-sky-400 font-medium block text-xs uppercase tracking-wider">{item.period}</span>
                  <div class="text-white font-medium">{item.degree} — <span class="text-slate-300 font-normal">{item.specialization}</span></div>
                  {item.highlights && item.highlights.length > 0 && (
                    <ul class="text-xs text-slate-400 list-disc list-inside pt-1 space-y-0.5">
                      {item.highlights.map((h: string) => (
                        <li>{h}</li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </div>

          <!-- PSM -->
          <div class="border border-white/10 p-8 space-y-6 bg-ocean-950/60 backdrop-blur-sm">
            <div class="space-y-1">
              <p class="text-xs font-sans uppercase tracking-widest text-sky-400">Szkoła Muzyczna</p>
              <h4 class="text-xl font-display text-white">PSM I i II st. im. A. Krzanowskiego w Mławie</h4>
              <p class="text-xs text-slate-400 font-sans">Kształcenie instrumentalne i wokalne</p>
            </div>
            <ul class="space-y-4 text-sm text-slate-300 font-sans font-light divide-y divide-white/5">
              {musicSchoolEducation.map((item) => (
                <li class="pt-3 space-y-1">
                  <span class="text-sky-400 font-medium block text-xs uppercase tracking-wider">{item.period}</span>
                  <div class="text-white font-medium">{item.degree} — <span class="text-slate-300 font-normal">{item.specialization}</span></div>
                  {item.highlights && item.highlights.length > 0 && (
                    <ul class="text-xs text-slate-400 list-disc list-inside pt-1 space-y-0.5">
                      {item.highlights.map((h: string) => (
                        <li>{h}</li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Nagrody -->
        <div class="space-y-6 pt-4">
          <div class="space-y-2 text-center">
            <p class="text-xs font-sans uppercase tracking-[0.28em] text-sky-400">Uznanie</p>
            <h4 class="text-2xl font-display font-semibold text-white">Wybrane nagrody i laury artystyczne</h4>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {individualAwards.map((award) => (
              <div class="border border-white/10 p-5 space-y-2 bg-ocean-950/40">
                <span class="text-xs font-sans text-sky-400 font-medium">{award.year}</span>
                <h5 class="font-display text-base text-white">{award.title}</h5>
                <p class="text-xs text-slate-400 font-sans font-light">{award.issuer}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
