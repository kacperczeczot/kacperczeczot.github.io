---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import { base } from '../utils/cms';
import homeData from '../data/home.json';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const {
  title = 'Kacper Czeczot — Dyrygent · Multiinstrumentalista · Aranżer',
  description = 'Oficjalne portfolio artystyczne Kacpra Czeczota: dyrygentura symfoniczna i chóralna, wykonawstwo sceniczne, opracowania partytur oraz realizacja dźwięku.',
  image = `${base}/images/og-cover.svg`,
  type = 'website',
  jsonLd,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://kacperczeczot.github.io';
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://kacperczeczot.github.io');

const absoluteImage = image.startsWith('http://') || image.startsWith('https://')
  ? image
  : `${siteUrl}${image.startsWith('/') ? image : `/${image}`}`;

const defaultPersonSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${siteUrl}/#person`,
  name: 'Kacper Czeczot',
  givenName: 'Kacper',
  familyName: 'Czeczot',
  url: siteUrl,
  image: `${siteUrl}/images/dyplomhero.jpeg`,
  jobTitle: ['Dyrygent', 'Kapelmistrz', 'Multiinstrumentalista', 'Aranżer', 'Kierownik muzyczny', 'Realizator dźwięku'],
  description: 'Oficjalne portfolio artystyczne Kacpra Czeczota: dyrygentura symfoniczna i chóralna, prowadzenie orkiestr i chórów, wykonawstwo sceniczne, opracowania partytur oraz realizacja dźwięku.',
  email: homeData.contactEmail,
  gender: 'https://schema.org/Male',
  nationality: {
    '@type': 'Country',
    name: 'Polska'
  },
  sameAs: [
    homeData.youtubeUrl,
    homeData.facebookUrl,
    homeData.instagramUrl,
    homeData.musescoreUrl,
    homeData.githubUrl,
  ].filter(Boolean),
  hasOccupation: [
    {
      '@type': 'Occupation',
      name: 'Dyrygent / Conductor',
      description: 'Dyrygentura symfoniczna i chóralna, prowadzenie orkiestr i chórów, interpretacja dzieł muzycznych.'
    },
    {
      '@type': 'Occupation',
      name: 'Kapelmistrz / Bandmaster',
      description: 'Kierownictwo muzyczne i dyrygentura orkiestr dętych.'
    },
    {
      '@type': 'Occupation',
      name: 'Aranżer / Arranger & Orchestrator',
      description: 'Autorskie opracowania partytur symfonicznych, chóralnych i orkiestrowych.'
    },
    {
      '@type': 'Occupation',
      name: 'Multiinstrumentalista / Multi-instrumentalist',
      description: 'Wykonawstwo sceniczne: fortepian, klarnet, śpiew tenorowy, organy.'
    },
    {
      '@type': 'Occupation',
      name: 'Realizator dźwięku / Sound Engineer',
      description: 'Produkcja muzyczna, inżynieria dźwięku i realizacja sesyjna.'
    }
  ],
  award: [
    'Tytuł Najlepszego Absolwenta Wydziału Sztuki UWM (rok akademicki 2024/2025)',
    'Nagroda Dziekana Wydziału Sztuki UWM za wybitne artystyczne dzieło dyplomowe (Koncert „Finale” w Filharmonii Warmińsko-Mazurskiej)',
    'Dyplom ukończenia studiów z wyróżnieniem na Uniwersytecie Warmińsko-Mazurskim w Olsztynie',
    'Dyplom z wyróżnieniem i tytuł zawodowy muzyka — PSM I i II st. im. A. Krzanowskiego w Mławie',
    'Złoty i Srebrny Dyplom — XIV Międzynarodowy Festiwal Chóralny Canco Mediterrania (Hiszpania)',
    'Brązowy Dyplom — XIII Międzynarodowy Festiwal Kaunas Cantat (Litwa)',
    'I Miejsce w kategorii instrumentalnej — Karnolsky Summer Camp (Bułgaria)'
  ],
  memberOf: [
    { '@type': 'MusicGroup', name: 'Orkiestra GOK w Opinogórze Górnej' },
    { '@type': 'MusicGroup', name: 'Orkiestra Dęta OSP Rębowo' },
    { '@type': 'MusicGroup', name: 'Orkiestra Dęta OSP Chociszewo' },
    { '@type': 'MusicGroup', name: 'Chór im. prof. Wiktora Wawrzyczka UWM' },
    { '@type': 'MusicGroup', name: 'Miejska Młodzieżowa Orkiestra Dęta w Chorzelach' },
    { '@type': 'MusicGroup', name: 'Chór Cantores Varmienses' },
    { '@type': 'MusicGroup', name: 'Kameralny Zespół Wokalny Ars Vocale' }
  ],
  alumniOf: [
    {
      '@type': 'EducationalOrganization',
      name: 'Uniwersytet Warmińsko-Mazurski w Olsztynie',
      url: 'https://uwm.edu.pl',
      description: 'Wydział Sztuki, Instytut Muzyki — Dyrygentura (studia ukończone z wyróżnieniem i tytułem Najlepszego Absolwenta)'
    },
    {
      '@type': 'EducationalOrganization',
      name: 'Państwowa Szkoła Muzyczna I i II st. im. Andrzeja Krzanowskiego w Mławie',
      description: 'Wydział Wokalny (dyplom z wyróżnieniem, tytuł zawodowy muzyka) oraz Klasa Fortepianu (I stopień z wyróżnieniem)'
    }
  ],
  knowsAbout: [
    'Dyrygentura symfoniczna',
    'Dyrygentura chóralna',
    'Kapelmistrzostwo i orkiestry dęte',
    'Aranżacja muzyczna',
    'Orkiestracja i opracowanie partytur',
    'Wokalistyka klasyczna (Tenor)',
    'Fortepian',
    'Klarnet',
    'Teatr muzyczny, operetka i musical',
    'Produkcja muzyczna i realizacja dźwięku'
  ]
};

const defaultWebsiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: siteUrl,
  name: 'Kacper Czeczot',
  alternateName: [
    'Kacper Czeczot — Dyrygent · Multiinstrumentalista · Aranżer',
    'Kacper Czeczot — Oficjalna strona',
    'Kacper Czeczot Portfolio',
    'kacperczeczot.github.io'
  ],
  description: 'Oficjalne portfolio artystyczne Kacpra Czeczota: dyrygentura symfoniczna i chóralna, wykonawstwo sceniczne, opracowania partytur oraz realizacja dźwięku.',
  about: {
    '@id': `${siteUrl}/#person`
  },
  creator: {
    '@id': `${siteUrl}/#person`
  },
  publisher: {
    '@id': `${siteUrl}/#person`
  },
  inLanguage: 'pl-PL'
};

const schemas = [
  defaultPersonSchema,
  defaultWebsiteSchema,
  ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])
];
---

<!doctype html>
<html lang="pl" class="scroll-smooth bg-ocean-950 text-slate-100 antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Favicon & App Icons -->
    <link rel="icon" href={`${base}/favicon.ico`} sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="48x48" href={`${base}/favicon-48x48.png`} />
    <link rel="icon" type="image/png" sizes="96x96" href={`${base}/favicon-96x96.png`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}/favicon-192x192.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <!-- SEO & Metadata -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Kacper Czeczot" />
    <meta name="keywords" content="Kacper Czeczot, Kacper Czeczot dyrygent, Kacper Czeczot kapelmistrz, Kacper Czeczot aranżer, Kacper Czeczot multiinstrumentalista, Kacper Czeczot portfolio, dyrygent, kapelmistrz, aranżer, multiinstrumentalista, dyrygentura symfoniczna, dyrygentura chóralna, orkiestra dęta, chór Wawrzyczka, UWM Olsztyn, PSM Mława, Filharmonia Warmińsko-Mazurska, produkcja muzyczna, partytury, Olsztyn, Mława" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#070d1a" />
    <meta name="google-site-verification" content="zxKFZNbYi5E_0F0shQqNW9Rf6kDSELiFvr4S9znB82M" />

    <!-- Open Graph / Facebook -->
    <meta property="og:site_name" content="Kacper Czeczot" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={absoluteImage} />

    <!-- Schema.org JSON-LD -->
    {schemas.map((schema) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    ))}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col bg-ocean-950 text-slate-100 selection:bg-sky-500/30 selection:text-sky-200 relative overflow-x-hidden">

    <!-- Navigation -->
    <Navbar />

    <!-- Main Content Container -->
    <main class="flex-1 w-full relative">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Global Components -->
    <Lightbox />
  </body>
</html>
