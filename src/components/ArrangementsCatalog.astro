---
import { Music2, ExternalLink, PlayCircle, Mail } from 'lucide-astro';
import arrangementsData from '../data/arrangements.json';
import homeData from '../data/home.json';

interface ArrangementItem {
  title: string;
  originalAuthor?: string;
  category: string;
  ensemble: string;
  year?: string;
  notes?: string;
  youtubeUrl?: string;
  musescoreUrl?: string;
}

const categoryLabels: Record<string, string> = {
  'symfoniczno-choralne': 'Symfoniczno-chóralne',
  'orkiestra-deta': 'Orkiestry dęte',
  'choralne': 'Chóralne',
  'kameralne': 'Kameralne / Inne',
};

const items: ArrangementItem[] = arrangementsData.items || [];
const activeCategories = Array.from(new Set(items.map((i) => i.category))).filter(Boolean);
const showFilters = activeCategories.length > 1;
const musescoreProfileUrl = homeData.musescoreUrl || 'https://musescore.com/user/4841481';
---

<section id="aranzacje" class="py-20 border-t border-white/10 bg-ocean-900/25">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
    <!-- Header -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
      <div class="space-y-3 max-w-2xl">
        <p class="text-xs font-sans uppercase tracking-[0.28em] text-sky-400">
          {arrangementsData.sectionBadge || 'Aranżacje & Partytury'}
        </p>
        <h2 class="text-3xl sm:text-4xl font-display font-semibold text-white tracking-tight">
          {arrangementsData.sectionTitle || 'Katalog opracowań'}
        </h2>
        <p class="text-base text-slate-300 font-sans font-light leading-relaxed">
          {arrangementsData.sectionSubtitle}
        </p>
      </div>

      {showFilters && (
        <div
          id="arrangements-filter-bar"
          class="flex flex-wrap items-center gap-2"
          role="group"
          aria-label="Filtruj aranżacje według obsady"
        >
          <button
            type="button"
            data-arr-filter="all"
            aria-pressed="true"
            class="arr-filter-btn px-4 py-2 text-xs font-sans font-semibold uppercase tracking-wider border border-sky-400 bg-sky-500/20 text-white transition-all"
          >
            Wszystkie ({items.length})
          </button>
          {activeCategories.map((cat) => {
            const count = items.filter((i) => i.category === cat).length;
            return (
              <button
                type="button"
                data-arr-filter={cat}
                aria-pressed="false"
                class="arr-filter-btn px-4 py-2 text-xs font-sans font-semibold uppercase tracking-wider border border-white/15 bg-ocean-950/60 text-slate-300 hover:text-white hover:border-sky-400/40 transition-all"
              >
                {categoryLabels[cat] || cat} ({count})
              </button>
            );
          })}
        </div>
      )}
    </div>

    <!-- Arrangements Grid -->
    <div id="arrangements-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {items.map((item, idx) => (
        <article
          data-arr-category={item.category}
          class="arr-card border border-white/10 bg-ocean-950/70 p-6 sm:p-7 flex flex-col justify-between gap-6 editorial-hover"
        >
          <div class="space-y-4">
            <div class="flex items-center justify-between gap-3">
              <span class="text-[11px] font-mono uppercase tracking-wider text-sky-400">
                {String(idx + 1).padStart(2, '0')} · {categoryLabels[item.category] || item.category}
              </span>
              {item.year && (
                <span class="text-xs font-mono text-slate-400 tabular-nums">{item.year}</span>
              )}
            </div>

            <div class="space-y-1">
              <h3 class="text-xl font-display font-semibold text-white tracking-tight leading-snug">
                {item.title}
              </h3>
              {item.originalAuthor && (
                <p class="text-xs font-sans text-slate-400">
                  oryg. {item.originalAuthor}
                </p>
              )}
            </div>

            <div class="pt-3 border-t border-white/10 space-y-2">
              <p class="text-xs font-sans text-sky-200/90 font-medium">
                Obsada: <span class="text-slate-200 font-normal">{item.ensemble}</span>
              </p>
              {item.notes && (
                <p class="text-sm text-slate-300 font-sans font-light leading-relaxed">
                  {item.notes}
                </p>
              )}
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-3 pt-4 border-t border-white/10">
            {item.musescoreUrl && (
              <a
                href={item.musescoreUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs font-sans font-semibold uppercase tracking-wider text-sky-300 hover:text-sky-200 transition-colors"
              >
                <Music2 class="w-3.5 h-3.5" />
                <span>Partytura</span>
                <ExternalLink class="w-3 h-3 opacity-70" />
              </a>
            )}
            {item.youtubeUrl && (
              <a
                href={item.youtubeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs font-sans font-semibold uppercase tracking-wider text-slate-300 hover:text-sky-300 transition-colors"
              >
                <PlayCircle class="w-3.5 h-3.5 text-sky-400" />
                <span>Nagranie YouTube</span>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>

    <!-- MuseScore & Custom Commissions CTA -->
    <div class="border border-sky-400/20 bg-gradient-to-r from-ocean-900/90 via-ocean-950 to-ocean-900/90 p-6 sm:p-8 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
      <div class="space-y-1.5 max-w-2xl">
        <p class="text-xs font-sans uppercase tracking-[0.22em] text-sky-400 font-semibold">
          Pełne archiwum nutowe & zamówienia
        </p>
        <h3 class="text-xl sm:text-2xl font-display font-semibold text-white">
          Partytury na MuseScore i opracowania na indywidualny skład
        </h3>
        <p class="text-sm text-slate-300 font-sans font-light leading-relaxed">
          Przeglądaj opublikowane opracowania na profilu MuseScore lub skontaktuj się w sprawie przygotowania partytury dopasowanej do konkretnej orkiestry dętej, symfonicznej lub chóru.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3 flex-shrink-0">
        <a
          href={musescoreProfileUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-3 text-xs font-sans font-semibold uppercase tracking-[0.18em] text-white border border-sky-400/50 bg-sky-500/15 hover:bg-sky-500/25 hover:border-sky-300 transition-all"
        >
          <Music2 class="w-4 h-4 text-sky-300" />
          <span>Profil MuseScore</span>
          <ExternalLink class="w-3.5 h-3.5 opacity-80" />
        </a>
        <a
          href="#kontakt"
          class="inline-flex items-center gap-2 px-5 py-3 text-xs font-sans font-semibold uppercase tracking-[0.18em] text-slate-200 border border-white/15 hover:border-sky-400/50 hover:text-sky-200 transition-all"
        >
          <Mail class="w-4 h-4 text-sky-400" />
          <span>Zamów opracowanie</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  function initArrangementsFilter() {
    const bar = document.getElementById('arrangements-filter-bar');
    const grid = document.getElementById('arrangements-grid');
    if (!bar || !grid || bar.dataset.bound === 'true') return;
    bar.dataset.bound = 'true';

    const buttons = bar.querySelectorAll<HTMLButtonElement>('.arr-filter-btn');
    const cards = grid.querySelectorAll<HTMLElement>('.arr-card');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-arr-filter') || 'all';

        buttons.forEach((b) => {
          const active = b === btn;
          b.setAttribute('aria-pressed', active ? 'true' : 'false');
          b.classList.toggle('border-sky-400', active);
          b.classList.toggle('bg-sky-500/20', active);
          b.classList.toggle('text-white', active);
          b.classList.toggle('border-white/15', !active);
          b.classList.toggle('bg-ocean-950/60', !active);
          b.classList.toggle('text-slate-300', !active);
        });

        cards.forEach((card) => {
          const cat = card.getAttribute('data-arr-category');
          const visible = filter === 'all' || cat === filter;
          card.classList.toggle('hidden', !visible);
        });
      });
    });
  }

  document.addEventListener('astro:page-load', initArrangementsFilter);
</script>
