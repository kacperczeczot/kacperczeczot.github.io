---
import { Film, Play } from 'lucide-astro';

interface Props {
  youtubeId?: string;
  title: string;
  partNumber?: number;
  featured?: boolean;
}

const { youtubeId = '', title, partNumber, featured = false } = Astro.props;
const hasValidVideo = youtubeId && youtubeId.trim().length > 0 && youtubeId !== 'dQw4w9WgXcQ';
const posterUrl = hasValidVideo ? `https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg` : '';
const highResPosterUrl = hasValidVideo ? `https://i.ytimg.com/vi/${youtubeId}/maxresdefault.jpg` : '';
---

<div class={`group relative overflow-hidden border border-white/10 bg-ocean-900 transition-all duration-300 hover:border-sky-400/40 ${featured ? 'p-1' : ''}`}>
  <!-- Video Header Bar -->
  <div class="px-5 py-3.5 bg-ocean-950 border-b border-sky-500/15 flex items-center justify-between gap-3">
    <div class="flex items-center gap-3 min-w-0">
      <span class="flex items-center justify-center w-7 h-7 border border-white/15 text-sky-300 text-xs font-display font-semibold flex-shrink-0">
        {partNumber ? `0${partNumber}` : <Film class="w-3.5 h-3.5 text-sky-400" />}
      </span>
      <h3 class="text-xs sm:text-sm font-display font-semibold text-white truncate group-hover:text-sky-300 transition-colors">
        {title}
      </h3>
    </div>
    <span class="text-[10px] font-display uppercase tracking-wider text-sky-400 flex items-center gap-1.5 flex-shrink-0 font-semibold">
      <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
      Wideo
    </span>
  </div>

  <!-- Video Container (16:9) — Lite YouTube Facade -->
  <div
    class="relative w-full aspect-video bg-ocean-950 overflow-hidden flex items-center justify-center"
    data-yt-facade={hasValidVideo ? youtubeId : undefined}
    data-yt-title={title}
  >
    {hasValidVideo ? (
      <button
        type="button"
        aria-label={`Odtwórz wideo: ${title}`}
        class="yt-play-trigger relative w-full h-full flex items-center justify-center cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-sky-400"
      >
        <img
          src={highResPosterUrl}
          onerror={`this.onerror=null;this.src='${posterUrl}'`}
          alt={`Miniatura wideo: ${title}`}
          loading="lazy"
          decoding="async"
          class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:opacity-95 group-hover:scale-105 transition-all duration-500"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ocean-950/75 via-ocean-950/20 to-ocean-950/30 pointer-events-none"></div>
        <span class="relative z-10 w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-ocean-950/85 border border-sky-400/50 backdrop-blur-md flex items-center justify-center text-sky-300 shadow-[0_0_30px_rgba(14,165,233,0.35)] group-hover:scale-110 group-hover:bg-sky-500 group-hover:text-white group-hover:border-sky-300 transition-all duration-300">
          <Play class="w-7 h-7 sm:w-8 sm:h-8 fill-current ml-1" />
        </span>
      </button>
    ) : (
      <div class="p-8 text-center space-y-3 max-w-md mx-auto">
        <div class="w-12 h-12 border border-white/15 flex items-center justify-center text-sky-400 mx-auto">
          <Film class="w-6 h-6 text-sky-400" />
        </div>
        <div class="space-y-1">
          <p class="font-display font-bold text-sm text-slate-100">{title}</p>
          <p class="text-xs text-slate-400">Rejestracja Koncertowa / Studyjna</p>
        </div>
      </div>
    )}
  </div>
</div>

<script>
  function initYoutubeFacades() {
    document.querySelectorAll<HTMLElement>('[data-yt-facade]').forEach((container) => {
      if (container.dataset.ytBound === 'true') return;
      container.dataset.ytBound = 'true';

      const trigger = container.querySelector('.yt-play-trigger');
      const ytId = container.getAttribute('data-yt-facade');
      const ytTitle = container.getAttribute('data-yt-title') || 'Odtwarzacz YouTube';

      if (!trigger || !ytId) return;

      trigger.addEventListener('click', () => {
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(ytId)}?rel=0&modestbranding=1&autoplay=1`;
        iframe.title = ytTitle;
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.className = 'absolute inset-0 w-full h-full border-0';
        container.innerHTML = '';
        container.appendChild(iframe);
      }, { once: true });
    });
  }

  document.addEventListener('astro:page-load', initYoutubeFacades);
</script>
