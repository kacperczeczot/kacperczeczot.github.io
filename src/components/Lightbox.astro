---
import { X, ChevronLeft, ChevronRight } from 'lucide-astro';
---

<!-- Global Accessible Lightbox Component -->
<div
  id="global-lightbox"
  class="fixed inset-0 z-50 hidden bg-black/90 backdrop-blur-md flex items-center justify-center p-4 sm:p-6 transition-opacity duration-300 opacity-0"
  role="dialog"
  aria-modal="true"
  aria-label="Podgląd powiększonego zdjęcia"
>
  <!-- Close Button -->
  <button
    id="lightbox-close-btn"
    type="button"
    aria-label="Zamknij podgląd zdjęcia"
    class="absolute top-6 right-6 z-10 p-3 border border-white/15 bg-ocean-950/90 text-slate-300 hover:text-white transition-all focus:outline-none focus:ring-2 focus:ring-sky-400"
  >
    <X class="w-6 h-6" />
  </button>

  
  <!-- Navigation -->
  <button id="lightbox-prev-btn" type="button" aria-label="Poprzednie zdjęcie" class="absolute left-4 z-10 p-3 bg-ocean-950/80 text-white rounded-full hover:bg-sky-600 transition-colors focus:outline-none focus:ring-2 focus:ring-sky-400 hidden sm:block">
    <ChevronLeft class="w-8 h-8" />
  </button>
  <button id="lightbox-next-btn" type="button" aria-label="Następne zdjęcie" class="absolute right-4 z-10 p-3 bg-ocean-950/80 text-white rounded-full hover:bg-sky-600 transition-colors focus:outline-none focus:ring-2 focus:ring-sky-400 hidden sm:block">
    <ChevronRight class="w-8 h-8" />
  </button>

  <!-- Image Container -->
  <div class="relative max-w-5xl max-h-[85vh] w-full flex flex-col items-center justify-center">
    <div class="relative overflow-hidden border border-white/10 bg-[#050810]">
      <img
        id="lightbox-image"
        src=""
        alt="Powiększone zdjęcie"
        class="max-w-full max-h-[75vh] w-auto h-auto object-contain transition-transform duration-300"
      />
    </div>

    <!-- Caption -->
    <div id="lightbox-caption" class="mt-4 text-center text-sm font-medium text-slate-300 font-sans tracking-wide px-4 py-2 border border-white/10 bg-ocean-950/90">
      Podgląd fotografii
    </div>
  </div>
</div>

<script>
  function setupLightbox() {
    const lightbox = document.getElementById('global-lightbox');
    const lightboxImg = document.getElementById('lightbox-image') as HTMLImageElement | null;
    const lightboxCaption = document.getElementById('lightbox-caption');
    const closeBtn = document.getElementById('lightbox-close-btn');
    const prevBtn = document.getElementById('lightbox-prev-btn');
    const nextBtn = document.getElementById('lightbox-next-btn');

    let currentImages: HTMLElement[] = [];
    let currentIndex = -1;


    if (!lightbox || !lightboxImg || !lightboxCaption || !closeBtn) return;

    function openLightbox(src: string, alt: string, captionHTML: string) {
      if (!lightbox || !lightboxImg || !lightboxCaption) return;
      lightboxImg.src = src;
      lightboxImg.alt = alt || 'Zdjęcie archiwalne';
      lightboxCaption.innerHTML = captionHTML || alt || 'Podgląd fotografii';
      
      lightbox.classList.remove('hidden');
      // Trigger animation
      requestAnimationFrame(() => {
        lightbox.classList.remove('opacity-0');
        lightbox.classList.add('opacity-100');
      });
      
      // Fix scrollbar jump
      const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
      document.body.style.paddingRight = `${scrollbarWidth}px`;
      document.body.style.overflow = 'hidden';
      
      updateNavButtons();
    }
    
    function updateNavButtons() {
       if (prevBtn) prevBtn.style.display = (currentIndex > 0) ? 'block' : 'none';
       if (nextBtn) nextBtn.style.display = (currentIndex >= 0 && currentIndex < currentImages.length - 1) ? 'block' : 'none';
    }


    function closeLightbox() {
      if (!lightbox || !lightboxImg) return;
      lightbox.classList.remove('opacity-100');
      lightbox.classList.add('opacity-0');
      
      setTimeout(() => {
        lightbox.classList.add('hidden');
        lightboxImg.src = '';
        document.body.style.overflow = '';
        document.body.style.paddingRight = '';
      }, 250);
    }

    closeBtn.addEventListener('click', closeLightbox);
    if (prevBtn) {
      prevBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (currentIndex > 0) {
          currentIndex--;
          showCurrent();
        }
      });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (currentIndex < currentImages.length - 1) {
          currentIndex++;
          showCurrent();
        }
      });
    }
    
    function showCurrent() {
        if (currentIndex >= 0 && currentIndex < currentImages.length) {
            const el = currentImages[currentIndex];
            const src = el.getAttribute('data-lightbox-src') || '';
            const alt = el.getAttribute('data-lightbox-alt') || '';
            const cap = el.getAttribute('data-lightbox-caption') || alt;
            if (src) openLightbox(src, alt, cap);
        }
    }


    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox || (e.target as HTMLElement).closest('#global-lightbox > div') === null) {
        closeLightbox();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('hidden')) {
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft' && currentIndex > 0) {
            currentIndex--; showCurrent();
        }
        if (e.key === 'ArrowRight' && currentIndex < currentImages.length - 1) {
            currentIndex++; showCurrent();
        }
      }
    });

    // Delegate clicks
    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('[data-lightbox-src]') as HTMLElement | null;
      if (target) {
        e.preventDefault();
        
        // Find all visible images to allow navigation
        currentImages = Array.from(document.querySelectorAll('[data-lightbox-src]')).filter(el => {
           // We only want images in the current active grid
           // The easiest way is to scope to the closest container, but since there are multiple levels, 
           // let's grab all from the same parent or closest identifiable section.
           const container = target.closest('#level-3-photos-grid, .grid');
           if (container) {
              return container.contains(el);
           }
           return true;
        }) as HTMLElement[];
        
        currentIndex = currentImages.indexOf(target);
        
        const src = target.getAttribute('data-lightbox-src') || '';
        const alt = target.getAttribute('data-lightbox-alt') || '';
        const caption = target.getAttribute('data-lightbox-caption') || alt;
        if (src) openLightbox(src, alt, caption);
      }
    });

    // Listen to custom event
    window.addEventListener('open-lightbox-event', (e: Event) => {
      const customEvent = e as CustomEvent<{ src: string; alt: string; caption?: string }>;
      if (customEvent.detail?.src) {
        openLightbox(customEvent.detail.src, customEvent.detail.alt, customEvent.detail.caption || customEvent.detail.alt);
      }
    });
  }

  // Setup on initial load and view transitions
  setupLightbox();
  document.addEventListener('astro:page-load', setupLightbox);
</script>
